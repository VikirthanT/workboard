FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
# ATI is one site, in India: "today" for due dates, overdue and reports is the Indian date (the server uses its own
# clock). tzdata is installed on purpose: without zone files a TZ value is silently ignored and the clock stays UTC.
ENV TZ=Asia/Kolkata
RUN apt-get update && apt-get install -y --no-install-recommends tzdata && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY server/ .

EXPOSE 8000

# The schema comes only from the migrations: apply them, then serve. No seeding happens here.
CMD ["sh", "-c", "alembic upgrade head && uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2"]
