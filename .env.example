# Copy this file to .env (gitignored) and fill in the values.
# Lines starting with "# " below are optional settings with a default; remove the "# " to change one.
# Quote a value if it contains spaces or # & $.


# ── Database (required) ───────────────────────────────────────────────────────
# Used by both stacks: docker-compose.dev.yml (make dev) and docker-compose.yml (make prod-up).
# make and docker compose build the connection string from these parts, so there is one password to keep.

# REQUIRED, no default anywhere. Generate one:   openssl rand -hex 24
# (hex is URL-safe; any password must avoid @ : / ? # $ & because it goes into the connection string)
POSTGRES_PASSWORD=

# POSTGRES_USER=workboard
# POSTGRES_DB=workboard

# Host port of the dev database only (127.0.0.1). The prod database publishes no port.
# POSTGRES_PORT=5436

# DO NOT SET THIS NORMALLY. POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB above are enough: make and docker
# compose build the connection string from them. A stray DATABASE_URL here (for example one pointing at another
# Postgres on port 5432) overrides them and breaks make dev and make test, so delete the line if you have one.
# You only need it to point at a different database than the local one, instead of the one built above. Syntax:
#   postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# For the local dev database that is, with the values above:
#   postgresql+psycopg://workboard:<POSTGRES_PASSWORD>@127.0.0.1:5436/workboard
# "+psycopg" names the driver; a plain postgresql:// works too, the server adds it. A password with @ : / ? # or %
# must be URL-encoded (a hex password from `openssl rand -hex 24` needs no encoding).
# DATABASE_URL=


# ── People directory ──────────────────────────────────────────────────────────
# Who exists comes from the Slack workspace (users.list), not from a file. It needs SLACK_BOT_TOKEN (below) with the
# users:read and users:read.email scopes. `make prod-up` syncs once on start (`make prod-sync-people` runs it again by hand,
# `make db-sync-people` in development); an admin can press "Sync people from Slack" in the Teams portal; and the
# `directory-sync` service runs it on this schedule, in India time: a day (mon to sun, weekdays or daily) and a 24-hour time,
# separated by commas. Empty = never automatically. Every run is written to the audit log.
# DIRECTORY_SYNC_SCHEDULE=sun 22:00


# ── Google sign-in ────────────────────────────────────────────────────────────
# Create the OAuth client in Google Cloud Console (APIs & Services, Credentials, "Web application"; consent
# screen "Internal" so only @atimotors.com can sign in). What it needs and why: docs/DEPLOYMENT.md.
# Until all of these are set, sign-in is the development account list (make dev) and production answers 501.

# From the OAuth client you created.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Where Google sends the browser back. It must be listed under the client's "Authorised redirect URIs".
# It goes through the frontend's address, so it works the same with the Vite dev proxy and with nginx.
#   development:  http://localhost:5173/api/auth/google/callback
#   production:   https://<your-domain>/api/auth/google/callback   (Google requires https for a real domain)
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Signs the session tokens. At least 32 characters; generate one:   openssl rand -hex 32
# SECRET_KEY=

# How long a session lasts, in seconds (28800 = 8 hours). After that the person signs in again.
# TOKEN_TTL_SECONDS=28800


# ── Suggestions (tasks proposed from the standups) ────────────────────────────
# Off until STANDUP_DB_URL and the LLM settings are all set. Nothing here has a default choice in the code.

# The standup app's database. We only ever read it, never write. On the production server we read a copy, not the live
# file (the standup app's database is in WAL mode, which a read only mount cannot open; `make prod-standup-snapshot`
# keeps the copy fresh, see docs/DEPLOYMENT.md):
#   sqlite:////opt/standup-snapshot/standup.db
# (four slashes = absolute path). In development point it at a local copy of the standup backup.
# STANDUP_DB_URL=
# Production only: the folder on the host that holds that copy, mounted read only into the API container at
# /opt/standup-snapshot (so STANDUP_DB_URL above stays the same). Only needed if it is not ./standup-snapshot.
# STANDUP_DB_DIR=



# When the standups are read on their own (the `scheduler` service; `make scheduler-dev` locally), in India time:
# a day (mon to sun, weekdays or daily) and a 24-hour time, separated by commas. Standups are posted on Monday and
# people load their text on Tuesday, so read on Tuesday and again on Wednesday for late ones. Empty = never
# automatically (only when a manager presses Sync). It never creates a task.
# STANDUP_SYNC_SCHEDULE=tue 12:00, wed 12:00

# Which LLM turns standup text into suggested tasks: groq | anthropic | openai_compatible.
# Change these three lines to switch model or provider, no code change.
# LLM_PROVIDER=
# LLM_MODEL=
# The provider's API key. Keep it only here.
# LLM_API_KEY=
# Only for openai_compatible, e.g. a local Ollama: http://127.0.0.1:11434/v1
# LLM_BASE_URL=


# ── Slack app (task announcements and DMs; the code is not built yet) ─────────
# Create the app and get both tokens by following docs/SLACK_SETUP.md. Keep them only here, never in git or in a chat.
# SLACK_BOT_TOKEN=xoxb-
# SLACK_APP_TOKEN=xapp-


# ── Server ────────────────────────────────────────────────────────────────────

# Company email domain accepted for sign-in and for the people directory.
# ALLOWED_EMAIL_DOMAIN=atimotors.com

# Emails (comma separated) of the first admins. Every people sync from Slack makes these people admin if they are not (this is
# how the first admin gets in); they must be in the Slack workspace. Set it in your own .env; never commit real addresses here.
# BOOTSTRAP_ADMIN_EMAILS=first.admin@your-domain.com
