# Copy this file to .env (gitignored) and fill in the values.
# Lines starting with "# " below are optional settings with a default; remove the "# " to change one.
# Quote a value if it contains spaces or # & $.


# ── Database (required) ───────────────────────────────────────────────────────
# Used by both stacks: docker-compose.dev.yml (make dev) and docker-compose.yml (make prod-up).
# make and docker compose build the connection string from these parts, so there is one password to keep.

# REQUIRED, no default anywhere. Generate one:   openssl rand -hex 24
# (hex is URL-safe; any password must avoid @ : / ? # $ & because it goes into the connection string)
POSTGRES_PASSWORD=

# POSTGRES_USER=workboard
# POSTGRES_DB=workboard

# Host port of the dev database only (127.0.0.1). The prod database publishes no port.
# POSTGRES_PORT=5436

# DO NOT SET THIS NORMALLY. POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB above are enough: make and docker
# compose build the connection string from them. A stray DATABASE_URL here (for example one pointing at another
# Postgres on port 5432) overrides them and breaks make dev and make test, so delete the line if you have one.
# You only need it to point at a different database than the local one, instead of the one built above. Syntax:
#   postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# For the local dev database that is, with the values above:
#   postgresql+psycopg://workboard:<POSTGRES_PASSWORD>@127.0.0.1:5436/workboard
# "+psycopg" names the driver; a plain postgresql:// works too, the server adds it. A password with @ : / ? # or %
# must be URL-encoded (a hex password from `openssl rand -hex 24` needs no encoding).
# DATABASE_URL=


# ── People directory ──────────────────────────────────────────────────────────
# The people loaded into the database (make db-seed, make dev, make prod-up).
# Real names, emails and Slack IDs: keep the file out of git. Make it from the Slack user cache with
#   python3 seed/csv_to_people.py [path-to-csv]
# It can be a file, or a folder that contains people.json. If it is missing, the database load is skipped
# with a note and nothing fails.
# PEOPLE_FILE=seed/people.json


# ── Google sign-in ────────────────────────────────────────────────────────────
# Create the OAuth client in Google Cloud Console (APIs & Services, Credentials, "Web application"; consent
# screen "Internal" so only @atimotors.com can sign in). What it needs and why: docs/DEPLOYMENT.md.
# Until all of these are set, sign-in is the development account list (make dev) and production answers 501.

# From the OAuth client you created.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Where Google sends the browser back. It must be listed under the client's "Authorised redirect URIs".
# It goes through the frontend's address, so it works the same with the Vite dev proxy and with nginx.
#   development:  http://localhost:5173/api/auth/google/callback
#   production:   https://<your-domain>/api/auth/google/callback   (Google requires https for a real domain)
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Signs the session tokens. At least 32 characters; generate one:   openssl rand -hex 32
# SECRET_KEY=

# How long a session lasts, in seconds (28800 = 8 hours). After that the person signs in again.
# TOKEN_TTL_SECONDS=28800


# ── Server ────────────────────────────────────────────────────────────────────

# Company email domain accepted for sign-in and for the people directory.
# ALLOWED_EMAIL_DOMAIN=atimotors.com

# Emails (comma separated) of the first admins. `make db-seed` makes these people admin before anything else.
# Set it in your own .env; never commit real addresses here.
# BOOTSTRAP_ADMIN_EMAILS=first.admin@your-domain.com
